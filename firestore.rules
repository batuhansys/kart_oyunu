rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profil + cuzdan. riskCoin client'tan yazilabilir (tek oyunculu /
    // magaza akislari icin, bkz. lib/state/wallet_provider.dart) ama
    // kimlik alanlari (username, isAdmin) kayittan sonra degistirilemez.
    // Cok oyunculu sehir maclarinin giris ucreti/odulu ise sunucudan
    // (firebase-admin ile, bu kurallari hic gormeden) islenir.
    match /users/{uid} {
      // Herhangi bir giris yapmis kullanici baska birinin profilini
      // okuyabilir (arkadas aramasi/istek listesi bunu gerektirir, bkz.
      // FirebaseFriendsRepository) — yazma hala sadece sahibine acik,
      // bu yuzden bakiye/seviye gorunur olsa da degistirilemez.
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.isAdmin == resource.data.isAdmin;
      allow delete: if false;
    }

    // Kullanici adi -> uid haritasi (kayitta benzersizlik + arkadas
    // aramasi icin). Sadece kendi uid'ini yazan kisi rezerve edebilir.
    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Arkadaslik istekleri: dokuman id'si iki uid'in alfabetik sirali
    // birlesimidir (bkz. FirebaseFriendsRepository._requestId), boylece
    // iki kullanici arasinda en fazla bir istek/arkadaslik kaydi olabilir.
    // "Arkadaslar" listesi ayri bir alanda TUTULMAZ: status=='accepted'
    // olan istekler arkadasligin kendisi kabul edilir (bkz.
    // FirebaseFriendsRepository.fetchFriends) — bu sayede kabul islemi
    // tek dokuman guncellemesi olur, iki farkli kullanicinin dokumanina
    // ayni anda yazma (ve bunun icin sunucu araciligi) gerekmez.
    //
    // `resource == null` kontrolu: henuz hic istek gonderilmemis iki
    // kullanici icin bu dokuman yok — "zaten istek var mi" kontrolu
    // (sendRequest'teki on-okuma) boyle bir dokumani okumaya calisir;
    // bu kontrol olmadan resource.data erisimi kural degerlendirmesini
    // (ve dolayisiyla read'i) basarisiz kilar.
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      // Kabul edilmis bir arkadasligi taraflardan biri sonlandirabilir
      // (bkz. FriendsScreen "Arkadaşlıktan Çıkar"). Henuz pending/declined
      // olan bir istek silinemez — gonderen "geri cekmek" isterse bu MVP
      // kapsaminda desteklenmiyor.
      allow delete: if isSignedIn() && resource.data.status == 'accepted' &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
